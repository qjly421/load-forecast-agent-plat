        </mxCell>
        <mxCell id="e7" value="medium 最高 vs full 最高&#xa;（两条线各有千秋）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="r5_holiday" target="r5_champ">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="VAE/探索线延续" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r4_other" target="r5_vae">
