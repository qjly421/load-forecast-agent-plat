        <mxCell id="e4" value="冠军续航" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="r4" target="r5_champ">
          <mxGeometry relative="1" as="geometry" />
