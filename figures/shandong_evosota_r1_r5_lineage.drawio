        <mxCell id="e5" value="节假日机制" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="r4_holiday" target="r5_holiday">
          <mxGeometry relative="1" as="geometry" />
